# Copiar a .env. Generar una clave local con el comando indicado en el README.
SECRET_KEY=
# Base de cada integrante. Cambiarla en su .env y reiniciar Flask manualmente.
# Elegir otra base no copia ni sincroniza datos.
DATABASE_BACKEND=sqlite
# Valores: sqlite, supabase o auto (auto conserva DATABASE_URL y, si falta, usa SQLite).
# Sin DATABASE_URL se usa instance/compilando.sqlite.
# DATABASE_URL=sqlite:////ruta/absoluta/compilando.sqlite
# PostgreSQL/Supabase: la contraseña separada se aplica a la conexión sin concatenarla.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF@POOLER_HOST:5432/postgres
# DATABASE_PASSWORD=CONTRASENA_PRIVADA
# DATABASE_POOL_MODE=session
# Transaction pooler: usar su puerto 6543 y DATABASE_POOL_MODE=transaction.

# Solo en producción, con HTTPS y un servidor WSGI configurado:
# APP_ENV=production
# TRUSTED_HOSTS=compilando.example.com

# Opcional: respuestas con Gemini. Cada integrante configura su clave en .env.
# Usar un proyecto del nivel gratuito sin habilitar facturación.
GEMINI_API_KEY=
