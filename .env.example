# Copiar a .env. Generar una clave local con el comando indicado en el README.
SECRET_KEY=
# En desarrollo, sin DATABASE_URL se usa instance/compilando.sqlite.
# Producción rechaza SQLite o la ausencia de PostgreSQL.
# DATABASE_URL=sqlite:////ruta/absoluta/compilando.sqlite
# PostgreSQL: usar un perfil privado .env.supabase.local para probar sin cambiar este entorno.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF@POOLER_HOST:5432/postgres
# DATABASE_PASSWORD=CONTRASENA_EN_EL_ARCHIVO_PRIVADO
# DATABASE_POOL_MODE=session
# En Vercel, usar la URI Transaction pooler y DATABASE_POOL_MODE=transaction.
# STORAGE_BACKEND=database
# PostgreSQL usa database por defecto: avatares y adjuntos en la misma base.
# SQLite usa local por defecto. El modo local está prohibido en producción.

# Solo en producción, con HTTPS y un servidor WSGI configurado:
# APP_ENV=production
# TRUSTED_HOSTS=compilando.example.com

# Opcional: respuestas con Gemini. Cada integrante configura su clave en .env.
# Usar un proyecto del nivel gratuito sin habilitar facturación.
GEMINI_API_KEY=
