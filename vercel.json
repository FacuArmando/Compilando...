{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python build.py",
  "regions": ["iad1"],
  "functions": {
    "app.py": {
      "maxDuration": 90
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
